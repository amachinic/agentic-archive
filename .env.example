# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# optional model overrides
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GROQ_TEXT_MODEL=openai/gpt-oss-120b

# The agent can run on Claude instead of Groq -- useful when the Groq free
# tier is spent. With ATLAS_AGENT_PROVIDER unset, whichever key is present
# wins, Groq first.
ATLAS_AGENT_PROVIDER=groq
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
